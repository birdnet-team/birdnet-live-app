<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the ShareExtension target so a shared audio file can cross
	     the sandbox boundary. Must match ShareExtension.entitlements and the
	     App Group registered for both bundle IDs in the developer portal. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.tu-chemnitz.mi.kahst.birdnet-live</string>
	</array>
</dict>
</plist>
