<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ variant: the launcher's inner radius keeps the icon tile
     concentric with the widget's outer corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_accent_container" />
    <corners android:radius="@android:dimen/system_app_widget_inner_radius" />
</shape>
