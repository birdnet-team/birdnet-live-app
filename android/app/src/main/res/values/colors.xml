    <color name="widget_on_surface">#000000</color>
    <color name="widget_accent">#B00020</color>
    <!-- accent at ~12% alpha, matching _ModeCard's withAlpha(30) icon tile. -->
    <color name="widget_accent_container">#1EB00020</color>
</resources>
